# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ─── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Flask / App ──────────────────────────────────────────────────────────────
instance/
*.db
*.sqlite3
# NEVER commit real secrets. A trailing comment on the same line as a
# pattern does NOT work in .gitignore - it becomes part of the pattern.
.env
.env.*
!.env.example

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Dist / Build ─────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
*.tsbuildinfo

# ─── Agent session logs (local tooling, never project code) ───────────────────
sessions/
