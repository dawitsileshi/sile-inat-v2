# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production-XKCD327

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * only in development)
CORS_ORIGINS=*

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite in instance/ — override for PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/maternal_wellness

# ─── Safety alerts ────────────────────────────────────────────────────────────
# Where a self-harm disclosure is announced. Leave these unset and nothing
# breaks: the safety event is still recorded and the follow-up still opens,
# but NOBODY IS TOLD, and the log says so on every disclosure.
#
# Setup:
#   1. Talk to @BotFather on Telegram, /newbot, copy the token below.
#   2. The recipient opens the bot and presses Start — a bot cannot message
#      someone who has never written to it.
#   3. Get the chat id: message the bot, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
#      For a group (a rota rather than one person), add the bot to the group
#      and use the group's id, which is negative.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SAFETY_ALERT_TIMEOUT=10
